MARKETCOW_PROFILE=production
MARKETCOW_HOST=127.0.0.1
MARKETCOW_PORT=8790
MARKETCOW_HOME=/Volumes/T9/data/marketcow/production
MARKETCOW_ALLOWED_ROOT=/Volumes/T9/data/marketcow
MARKETCOW_POSTGRES_DSN_REF=MARKETCOW_POSTGRES_DSN
MARKETCOW_POSTGRES_DSN=postgresql://USER:PASSWORD@127.0.0.1:5432/marketcow_production
MARKETCOW_POSTGRES_SCHEMA=marketcow_production
MARKETCOW_CLICKHOUSE_HOST=127.0.0.1
MARKETCOW_CLICKHOUSE_PORT=8123
MARKETCOW_CLICKHOUSE_DATABASE=marketcow_production
MARKETCOW_CLICKHOUSE_USERNAME=marketcow
MARKETCOW_CLICKHOUSE_PASSWORD_REF=MARKETCOW_CLICKHOUSE_PASSWORD
MARKETCOW_CLICKHOUSE_PASSWORD=replace-me
MARKETCOW_CLICKHOUSE_BACKGROUND_CANONICAL=true
TUSHARE_TOKEN=
MARKETCOW_LONGPORT_APP_KEY=
MARKETCOW_LONGPORT_APP_SECRET=
MARKETCOW_LONGPORT_ACCESS_TOKEN=
MARKETCOW_QUOTE_PERSISTENCE_QUEUE_SIZE=256
MARKETCOW_QUOTE_PERSISTENCE_SHUTDOWN_SECONDS=5
MARKETCOW_SEC_USER_AGENT=MarketCow toczx@outlook.com
# Optional JSON list of additional dashboards served by the existing local Grafana instance.
MARKETCOW_DASHBOARD_REGISTRY_JSON=[]
MARKETCOW_ADMIN_AUTH_REQUIRED=true
# Intentionally empty: production startup fails closed until real tokens are supplied.
MARKETCOW_ADMIN_TOKENS_JSON={}
# Browser users use scrypt password hashes; bootstrap tokens remain for API clients.
MARKETCOW_ADMIN_USERS_JSON={}
MARKETCOW_SERVICE_ACCOUNTS_JSON={}
MARKETCOW_ADMIN_SESSION_SECONDS=2592000
MARKETCOW_ADMIN_COOKIE_SECURE=false
MARKETCOW_ADMIN_FRONTEND_ENABLED=true
MARKETCOW_ADMIN_GRAFANA_ENABLED=true
MARKETCOW_ADMIN_COMMANDS_ENABLED=true
MARKETCOW_ADMIN_LIVE_ENABLED=true
MARKETCOW_ADMIN_LIVE_MAX_CONNECTIONS=100
# MarketCow exposes the read-only /mcp endpoint by default.
MARKETCOW_MCP_ENABLED=true
# LLMAY public read boundary is fail-closed until all values below are reviewed.
MARKETCOW_PUBLIC_READ_ENABLED=false
MARKETCOW_PUBLIC_READ_ALLOWLIST_JSON=[]
MARKETCOW_PUBLIC_RATE_LIMIT_REQUESTS=60
MARKETCOW_PUBLIC_RATE_LIMIT_WINDOW_SECONDS=60
MARKETCOW_PUBLIC_AUDIT_PATH=/Volumes/T9/data/marketcow/production/audit/public-access.jsonl
MARKETCOW_INVESTRACE_JWT_ISSUER=
MARKETCOW_INVESTRACE_JWT_AUDIENCE=marketcow-public
MARKETCOW_INVESTRACE_JWT_SCOPE=marketcow:read
MARKETCOW_INVESTRACE_JWT_KEYS_JSON={}
MARKETCOW_PUBLIC_JWT_ISSUER=marketcow
MARKETCOW_PUBLIC_JWT_AUDIENCE=llmay
MARKETCOW_PUBLIC_JWT_SCOPE=llmay:read
MARKETCOW_PUBLIC_JWT_KEYS_JSON={}
MARKETCOW_PUBLIC_JWT_LEEWAY_SECONDS=30
MARKETCOW_PUBLIC_JWT_MAX_LIFETIME_SECONDS=3600
MARKETCOW_POLYMARKET_CONSUMER_MAXIMUM_BOOK_AGE_SECONDS=5.0
MARKETCOW_POLYMARKET_MINIMUM_DELIVERY_HEADROOM_SECONDS=1.0
MARKETCOW_POLYMARKET_DISCOVERY_DEPTH_NOTIONALS=10,50,100,500
MARKETCOW_POLYMARKET_DISCOVERY_STREAM_PORT=8795
MARKETCOW_POLYMARKET_DISCOVERY_SHARD_SIZE=500
MARKETCOW_POLYMARKET_DISCOVERY_MAX_WEBSOCKET_CONNECTIONS=32
# The production supervisor treats Polymarket as a required MarketCow data
# service. These absolute paths must describe one validated exact scope.
MARKETCOW_POLYMARKET_SCOPE_MANIFEST=
MARKETCOW_POLYMARKET_SELECTION_REPORT=
MARKETCOW_POLYMARKET_CANDIDATE_SNAPSHOT=
MARKETCOW_POLYMARKET_TRADUDE_WORKTREE=
MARKETCOW_POLYMARKET_SNAPSHOT_REFRESH_SECONDS=2.0
MARKETCOW_POLYMARKET_STABLE_SNAPSHOT_MAX_BOOK_AGE_SECONDS=3.5
MARKETCOW_POLYMARKET_STABLE_READ_WAIT_SECONDS=6.0
MARKETCOW_POLYMARKET_STABLE_READ_POLL_SECONDS=0.025
MARKETCOW_POLYMARKET_READ_EXECUTOR_WORKERS=4
