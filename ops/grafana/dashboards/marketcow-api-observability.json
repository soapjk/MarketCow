      "id": 2,
      "targets": [{"expr": "sum(rate(marketcow_http_requests_total{status_family=~\"4xx|5xx\"}[$__rate_interval])) / clamp_min(sum(rate(marketcow_http_requests_total[$__rate_interval])), 1)", "refId": "A"}],
