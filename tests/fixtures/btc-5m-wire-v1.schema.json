{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "marketcow.polymarket.btc-5m-wire.v1",
  "title": "MarketCow Polymarket BTC five-minute research wire",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "cursor": {
      "type": "integer",
      "minimum": 0
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "token_id"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "Up",
            "Down"
          ]
        },
        "token_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "market_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "window_id",
        "start_at",
        "end_at",
        "market_id",
        "condition_id",
        "outcomes",
        "rule_sha256"
      ],
      "properties": {
        "role": {
          "enum": [
            "current",
            "next",
            "retiring"
          ]
        },
        "window_id": {
          "type": "string",
          "minLength": 1
        },
        "start_at": {
          "type": "string",
          "format": "date-time"
        },
        "end_at": {
          "type": "string",
          "format": "date-time"
        },
        "market_id": {
          "type": "string",
          "minLength": 1
        },
        "condition_id": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "outcomes": {
          "type": "array",
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/outcome"
                },
                {
                  "properties": {
                    "outcome": {
                      "const": "Up"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/outcome"
                },
                {
                  "properties": {
                    "outcome": {
                      "const": "Down"
                    }
                  }
                }
              ]
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "rule_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "profile_id",
        "profile_revision",
        "catalog_revision",
        "markets",
        "maximum_markets",
        "maximum_quote_age_ms",
        "maximum_tokens"
      ],
      "properties": {
        "schema_version": {
          "const": "marketcow.polymarket.btc-5m-profile.v1"
        },
        "profile_id": {
          "$ref": "#/$defs/sha256"
        },
        "profile_revision": {
          "type": "integer",
          "minimum": 1
        },
        "catalog_revision": {
          "$ref": "#/$defs/sha256"
        },
        "markets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/market_binding"
          },
          "minItems": 1,
          "maxItems": 3
        },
        "maximum_markets": {
          "const": 3
        },
        "maximum_quote_age_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "maximum_tokens": {
          "const": 6
        }
      }
    },
    "level": {
      "type": "object",
      "required": [
        "price",
        "size"
      ],
      "properties": {
        "price": {
          "type": "string"
        },
        "size": {
          "type": "string"
        }
      }
    },
    "token_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "token_id",
        "available",
        "replay_baseline_valid",
        "confirmation_sequence",
        "confirmed_at",
        "confirmation_source",
        "confirmation_evidence_sha256",
        "recovery_id",
        "recovery_snapshot_cursor",
        "freshness_at",
        "unavailable_reason",
        "publisher_cursor",
        "source_event_cursor",
        "book_epoch",
        "state_checksum",
        "canonical_book_sha256",
        "tick_version",
        "tick_size",
        "source_hash",
        "exchange_at",
        "received_at",
        "quote_age_ms",
        "future_skew_ms",
        "best_bid",
        "best_ask",
        "last_trade_price",
        "bids",
        "asks",
        "canonical_book"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "Up",
            "Down"
          ]
        },
        "token_id": {
          "type": "string",
          "minLength": 1
        },
        "available": {
          "type": "boolean"
        },
        "replay_baseline_valid": {
          "type": "boolean",
          "description": "Whether canonical_book is an exact continuity baseline for subsequent v2 deltas. This is independent of quote availability."
        },
        "confirmation_sequence": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "confirmed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "confirmation_source": {
          "type": ["string", "null"]
        },
        "confirmation_evidence_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "recovery_id": {
          "type": ["string", "null"]
        },
        "recovery_snapshot_cursor": {
          "oneOf": [
            {"$ref": "#/$defs/cursor"},
            {"type": "null"}
          ]
        },
        "freshness_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "unavailable_reason": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "market_window_ended",
            "market_window_inactive",
            "source_gap",
            "book_unavailable",
            "crossed_book",
            "quote_stale",
            "future_received_at",
            "incomplete_book"
          ]
        },
        "publisher_cursor": {
          "oneOf": [
            {
              "$ref": "#/$defs/cursor"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_event_cursor": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "book_epoch": {
          "type": [
            "string",
            "null"
          ]
        },
        "state_checksum": {
          "type": [
            "string",
            "null"
          ]
        },
        "canonical_book_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "tick_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "tick_size": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "exchange_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "received_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "quote_age_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "future_skew_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "best_bid": {
          "type": [
            "string",
            "null"
          ]
        },
        "best_ask": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_trade_price": {
          "type": [
            "string",
            "null"
          ]
        },
        "bids": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/level"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "asks": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/level"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "canonical_book": {
          "oneOf": [
            {
              "$ref": "#/$defs/canonical_book"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "window_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "window_id",
        "start_at",
        "end_at",
        "market_id",
        "condition_id",
        "status"
      ],
      "properties": {
        "role": {
          "enum": [
            "current",
            "next",
            "retiring"
          ]
        },
        "window_id": {
          "type": "string"
        },
        "start_at": {
          "type": "string",
          "format": "date-time"
        },
        "end_at": {
          "type": "string",
          "format": "date-time"
        },
        "market_id": {
          "type": "string"
        },
        "condition_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "ready",
            "unavailable",
            "book_terminated"
          ]
        }
      }
    },
    "market_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "window_id",
        "start_at",
        "end_at",
        "market_id",
        "condition_id",
        "rule_sha256",
        "status",
        "book_terminated",
        "settlement_status",
        "cross_token_atomic",
        "tokens"
      ],
      "properties": {
        "role": {
          "enum": [
            "current",
            "next",
            "retiring"
          ]
        },
        "window_id": {
          "type": "string"
        },
        "start_at": {
          "type": "string",
          "format": "date-time"
        },
        "end_at": {
          "type": "string",
          "format": "date-time"
        },
        "market_id": {
          "type": "string"
        },
        "condition_id": {
          "type": "string"
        },
        "rule_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "enum": [
            "ready",
            "unavailable",
            "book_terminated"
          ]
        },
        "book_terminated": {
          "type": "boolean"
        },
        "settlement_status": {
          "const": "independent"
        },
        "cross_token_atomic": {
          "const": false
        },
        "tokens": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/token_snapshot"
          },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "manager_status": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["schema_version", "owner", "lease_id", "lease_ttl_seconds",
        "renew_interval_seconds", "prereview_seconds", "control_timeout_seconds",
        "phase", "profile_id", "profile_revision", "error", "updated_at"],
      "properties": {
        "schema_version": {"const": "marketcow.polymarket.btc-5m-manager-status.v1"},
        "owner": {"const": "same_process_unified_marketcow"},
        "lease_id": {"const": "marketcow-btc5m-manager-v1"},
        "lease_ttl_seconds": {"const": 120},
        "renew_interval_seconds": {"const": 40},
        "prereview_seconds": {"const": 30},
        "control_timeout_seconds": {"const": 10},
        "phase": {"enum": ["discovering", "running", "next_reviewed", "fail_closed"]},
        "profile_id": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "profile_revision": {"type": ["integer", "null"], "minimum": 1},
        "error": {"type": ["string", "null"]},
        "updated_at": {"type": "string", "format": "date-time"}
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "profile_id",
        "profile_revision",
        "epoch",
        "published_cursor",
        "durable_cursor",
        "confirmation_sequence",
        "ready",
        "reason",
        "transport_alive",
        "heartbeat_and_quote_freshness_are_independent",
        "maximum_markets",
        "maximum_tokens",
        "windows",
        "profile_document_sha256",
        "profile",
        "manager"
      ],
      "properties": {
        "schema_version": {
          "const": "marketcow.polymarket.btc-5m-status.v1"
        },
        "profile_id": {
          "$ref": "#/$defs/sha256"
        },
        "profile_revision": {
          "type": "integer",
          "minimum": 1
        },
        "epoch": {
          "type": "string",
          "minLength": 1
        },
        "published_cursor": {
          "$ref": "#/$defs/cursor"
        },
        "durable_cursor": {
          "$ref": "#/$defs/cursor"
        },
        "confirmation_sequence": {
          "$ref": "#/$defs/cursor"
        },
        "ready": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "transport_alive": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "heartbeat_and_quote_freshness_are_independent": {
          "const": true
        },
        "maximum_markets": {
          "const": 3
        },
        "maximum_tokens": {
          "const": 6
        },
        "windows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/window_status"
          },
          "minItems": 1,
          "maxItems": 3
        },
        "profile_document_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "manager": {
          "$ref": "#/$defs/manager_status"
        }
      }
    },
    "full_sync": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "profile_id",
        "profile_revision",
        "epoch",
        "publisher_cursor",
        "durable_cursor",
        "confirmation_sequence",
        "ready",
        "maximum_quote_age_ms",
        "crossed_book_rule",
        "acquisition_membership_semantics",
        "ready_barrier",
        "after_cursor_semantics",
        "replay_expiry_recovery",
        "source_event_cursor_semantics",
        "transport_alive",
        "heartbeat_and_quote_freshness_are_independent",
        "unavailable_token_count",
        "observed_at",
        "markets",
        "profile_document_sha256",
        "profile",
        "manager"
      ],
      "properties": {
        "schema_version": {
          "const": "marketcow.polymarket.btc-5m-full-sync.v1"
        },
        "profile_id": {
          "$ref": "#/$defs/sha256"
        },
        "profile_revision": {
          "type": "integer",
          "minimum": 1
        },
        "epoch": {
          "type": "string",
          "minLength": 1
        },
        "publisher_cursor": {
          "$ref": "#/$defs/cursor"
        },
        "confirmation_sequence": {
          "$ref": "#/$defs/cursor"
        },
        "durable_cursor": {
          "$ref": "#/$defs/cursor"
        },
        "ready": {
          "type": "boolean"
        },
        "maximum_quote_age_ms": {
          "type": "integer"
        },
        "crossed_book_rule": {
          "const": "best_bid_greater_than_or_equal_to_best_ask_is_invalid"
        },
        "acquisition_membership_semantics": {
          "const": "component_subset_leases_deduplicated_shared_union_before_profile_cas"
        },
        "ready_barrier": {
          "const": "full_sync_cursor_then_stream_after_cursor_strictly_greater"
        },
        "after_cursor_semantics": {
          "const": "exclusive"
        },
        "replay_expiry_recovery": {
          "const": "new_full_sync"
        },
        "source_event_cursor_semantics": {
          "const": "upstream_optional_and_never_comparable_to_publisher_cursor"
        },
        "transport_alive": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "heartbeat_and_quote_freshness_are_independent": {
          "const": true
        },
        "unavailable_token_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "markets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/market_state"
          },
          "minItems": 1,
          "maxItems": 3
        },
        "profile_document_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "manager": {
          "$ref": "#/$defs/manager_status"
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "code",
        "retryable"
      ],
      "properties": {
        "schema_version": {
          "const": "marketcow.polymarket.btc-5m-error.v1"
        },
        "code": {
          "enum": [
            "btc_5m_epoch_changed",
            "btc_5m_future_cursor",
            "btc_5m_replay_expired",
            "btc_5m_snapshot_too_large",
            "btc_5m_snapshot_capacity",
            "btc_5m_stream_capacity",
            "btc_5m_unavailable"
          ]
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "type",
        "epoch",
        "publisher_cursor"
      ],
      "properties": {
        "schema_version": {
          "const": "marketcow.polymarket.btc-5m-event.v1"
        },
        "type": {
          "enum": [
            "book_snapshot",
            "book_change",
            "last_trade",
            "recovery_started",
            "recovery_completed",
            "ready",
            "profile_changed"
          ]
        },
        "epoch": {
          "type": "string",
          "minLength": 1
        },
        "publisher_cursor": {
          "$ref": "#/$defs/cursor"
        },
        "confirmation_sequence": {
          "$ref": "#/$defs/cursor"
        },
        "source_event_cursor": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "market_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "token_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "availability": {
          "enum": [
            "unavailable",
            "authoritative_snapshot",
            "unchanged"
          ]
        },
        "durability": {
          "const": "published_not_necessarily_durable"
        },
        "durable_cursor": {
          "$ref": "#/$defs/cursor"
        },
        "ready": {
          "type": "boolean"
        },
        "barrier": {
          "type": "string"
        },
        "source_event_type": {
          "type": "string"
        },
        "payload_semantics": {
          "enum": [
            "complete_post_state",
            "control_record"
          ]
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract_version",
            "source_schema_version",
            "publication_event_type",
            "raw_source_event_type",
            "event_id",
            "book_epoch",
            "sequence",
            "exchange_at",
            "received_at",
            "canonical_payload_sha256",
            "canonical_payload",
            "raw_payload_sha256",
            "applied",
            "fail_closed_reason",
            "gaps"
          ],
          "properties": {
            "contract_version": {
              "const": "marketcow.prediction_market.v1"
            },
            "source_schema_version": {
              "const": "marketcow.polymarket.live.v2"
            },
            "publication_event_type": {
              "enum": [
                "book",
                "recovery_started",
                "recovery_completed"
              ]
            },
            "raw_source_event_type": {
              "enum": [
                "book",
                "price_change",
                "last_trade_price",
                "source_gap",
                "recovery_completed"
              ]
            },
            "event_id": {
              "type": "string"
            },
            "book_epoch": {
              "type": [
                "string",
                "null"
              ]
            },
            "sequence": {
              "type": [
                "integer",
                "string",
                "null"
              ]
            },
            "exchange_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "received_at": {
              "type": "string"
            },
            "canonical_payload_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "canonical_payload": {
              "type": "object"
            },
            "raw_payload_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "applied": {
              "type": "boolean"
            },
            "fail_closed_reason": {
              "type": [
                "string",
                "null"
              ]
            },
            "gaps": {
              "type": "array"
            }
          }
        },
        "next_profile_id": {
          "$ref": "#/$defs/sha256"
        },
        "next_profile_revision": {
          "type": "integer",
          "minimum": 1
        },
        "next_epoch": {
          "type": "string"
        },
        "requires_new_full_sync": {
          "type": "boolean"
        }
      }
    },
    "canonical_book": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asks",
        "bids",
        "book_epoch",
        "condition_id",
        "exchange_at",
        "last_trade_price",
        "received_at",
        "sequence",
        "sequence_semantics",
        "source_hash",
        "state_checksum",
        "tick_size",
        "tick_version",
        "token_id"
      ],
      "properties": {
        "asks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/level"
          }
        },
        "bids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/level"
          }
        },
        "book_epoch": {
          "type": "string",
          "minLength": 1
        },
        "condition_id": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "exchange_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_trade_price": {
          "type": [
            "string",
            "null"
          ]
        },
        "received_at": {
          "type": "string",
          "format": "date-time"
        },
        "sequence": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "sequence_semantics": {
          "const": "deterministic_normalized"
        },
        "source_hash": {
          "$ref": "#/$defs/sha256"
        },
        "state_checksum": {
          "$ref": "#/$defs/sha256"
        },
        "tick_size": {
          "type": "string",
          "minLength": 1
        },
        "tick_version": {
          "$ref": "#/$defs/sha256"
        },
        "token_id": {
          "type": "string",
          "minLength": 1
        },
        "confirmed_at": {
          "type": "string",
          "format": "date-time"
        },
        "confirmation_source": {
          "type": "string",
          "minLength": 1
        },
        "confirmation_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "limits",
    "status",
    "full_sync",
    "source_events",
    "events",
    "source_gap_mapping",
    "clock_semantics",
    "errors"
  ],
  "properties": {
    "profile": {
      "$ref": "#/$defs/profile"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_bytes",
        "frame_bytes",
        "replay_bytes",
        "maximum_clients",
        "send_timeout_seconds",
        "snapshot_lease_capacity"
      ],
      "properties": {
        "snapshot_bytes": {
          "type": "integer",
          "minimum": 65536,
          "maximum": 16777216
        },
        "frame_bytes": {
          "type": "integer",
          "minimum": 4096,
          "maximum": 2097152
        },
        "replay_bytes": {
          "type": "integer",
          "minimum": 65536,
          "maximum": 8388608
        },
        "maximum_clients": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "send_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "snapshot_lease_capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        }
      }
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "full_sync": {
      "$ref": "#/$defs/full_sync"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "source_events": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": [
          "contract_version",
          "schema_version",
          "cursor",
          "event_type",
          "market_id",
          "condition_id",
          "token_id",
          "book_epoch",
          "sequence",
          "exchange_at",
          "received_at",
          "canonical_payload_sha256",
          "canonical_payload",
          "raw_payload_sha256",
          "raw_payload",
          "applied",
          "fail_closed_reason",
          "gaps",
          "event_id"
        ],
        "properties": {
          "contract_version": {
            "const": "marketcow.prediction_market.v1"
          },
          "schema_version": {
            "const": "marketcow.polymarket.live.v2"
          },
          "cursor": {
            "$ref": "#/$defs/cursor"
          },
          "event_type": {
            "enum": [
              "book",
              "recovery_started",
              "recovery_completed"
            ]
          },
          "market_id": {
            "type": "string"
          },
          "condition_id": {
            "pattern": "^0x[0-9a-f]{64}$"
          },
          "token_id": {
            "type": "string"
          },
          "book_epoch": {
            "type": [
              "string",
              "null"
            ]
          },
          "sequence": {
            "type": [
              "integer",
              "null"
            ]
          },
          "exchange_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "received_at": {
            "type": "string"
          },
          "canonical_payload_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "canonical_payload": {
            "type": "object"
          },
          "raw_payload_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "raw_payload": {
            "type": "object"
          },
          "applied": {
            "const": true
          },
          "fail_closed_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "gaps": {
            "type": "array"
          },
          "event_id": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "source_gap_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_source_event_type",
        "published_event_type",
        "semantics"
      ],
      "properties": {
        "raw_source_event_type": {
          "const": "source_gap"
        },
        "published_event_type": {
          "const": "recovery_started"
        },
        "semantics": {
          "const": "affected_token_unavailable_until_authoritative_book_then_recovery_completed"
        }
      }
    },
    "clock_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_received_at",
        "canonical_book_received_at",
        "quote_age_uses",
        "last_trade_refreshes_quote_age"
      ],
      "properties": {
        "event_received_at": {
          "const": "receipt time of this source event"
        },
        "canonical_book_received_at": {
          "const": "receipt time of the last book-mutating snapshot or price change"
        },
        "quote_age_uses": {
          "const": "canonical_book_received_at"
        },
        "last_trade_refreshes_quote_age": {
          "const": false
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "http_status",
          "body"
        ],
        "properties": {
          "http_status": {
            "type": "integer"
          },
          "body": {
            "$ref": "#/$defs/error"
          }
        }
      }
    }
  }
}
