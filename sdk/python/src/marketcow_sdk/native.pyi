from enum import IntEnum
from typing import AsyncIterator, Iterator

from ._native import (
    BtcCapabilities,
    BtcHealth,
    ConnectionEvent,
    Evidence,
    Finality,
    FinalizedWindow,
    HistoryLifecycle,
    HistoryPage,
    Market,
    MarketDirectory,
    MarketEvent,
    MarketSnapshot,
    ObservationPage,
    OfficialBook,
    OfficialBtcTrade,
    PriceEvent,
    PublicTerms,
    Reference,
    Rules,
    ServerUsage,
    Usage,
)

class Source(IntEnum):
    BINANCE_BTCUSDT = 1
    CHAINLINK_BTC_USD = 2
    CHAINLINK_TWAP60 = 3

class PriceSubscription(Iterator[PriceEvent | ConnectionEvent]):
    def __enter__(self) -> PriceSubscription: ...
    def __exit__(self, *args: object) -> None: ...
    def __next__(self) -> PriceEvent | ConnectionEvent: ...
    def close(self) -> None: ...

class AsyncPriceSubscription(AsyncIterator[PriceEvent | ConnectionEvent]):
    async def __aenter__(self) -> AsyncPriceSubscription: ...
    async def __aexit__(self, *args: object) -> None: ...
    async def __anext__(self) -> PriceEvent | ConnectionEvent: ...
    async def close(self) -> None: ...

class MarketSubscription(Iterator[MarketEvent]):
    def __enter__(self) -> MarketSubscription: ...
    def __exit__(self, *args: object) -> None: ...
    def __next__(self) -> MarketEvent: ...
    def snapshot(self, depth: int | None = None) -> MarketSnapshot | None: ...
    def close(self) -> None: ...

class AsyncMarketSubscription(AsyncIterator[MarketEvent]):
    async def __aenter__(self) -> AsyncMarketSubscription: ...
    async def __aexit__(self, *args: object) -> None: ...
    async def __anext__(self) -> MarketEvent: ...
    async def snapshot(self, depth: int | None = None) -> MarketSnapshot | None: ...
    async def close(self) -> None: ...

class TradeHistory(Iterator[HistoryPage]):
    def lifecycle(self) -> HistoryLifecycle: ...
    def __enter__(self) -> TradeHistory: ...
    def __exit__(self, *args: object) -> None: ...
    def __next__(self) -> HistoryPage: ...
    def save_checkpoint(self, path: str) -> None: ...
    def close(self) -> None: ...

class AsyncTradeHistory(AsyncIterator[HistoryPage]):
    async def lifecycle(self) -> HistoryLifecycle: ...
    async def __aenter__(self) -> AsyncTradeHistory: ...
    async def __aexit__(self, *args: object) -> None: ...
    async def __anext__(self) -> HistoryPage: ...
    async def save_checkpoint(self, path: str) -> None: ...
    async def close(self) -> None: ...

class ObservationHistory(Iterator[ObservationPage]):
    def __enter__(self) -> ObservationHistory: ...
    def __exit__(self, *args: object) -> None: ...
    def __next__(self) -> ObservationPage: ...
    def close(self) -> None: ...

class AsyncObservationHistory(AsyncIterator[ObservationPage]):
    async def __aenter__(self) -> AsyncObservationHistory: ...
    async def __aexit__(self, *args: object) -> None: ...
    async def __anext__(self) -> ObservationPage: ...
    async def close(self) -> None: ...

class Prices:
    def latest(self, source: Source = Source.BINANCE_BTCUSDT) -> PriceEvent: ...
    def subscribe(self, source: Source = Source.BINANCE_BTCUSDT) -> PriceSubscription: ...

class AsyncPrices:
    async def latest(self, source: Source = Source.BINANCE_BTCUSDT) -> PriceEvent: ...
    def subscribe(self, source: Source = Source.BINANCE_BTCUSDT) -> AsyncPriceSubscription: ...

class History:
    def trades(
        self, *, start_time_ms: int, end_time_ms: int | None = None, limit: int = 1000
    ) -> TradeHistory: ...
    def trades_through(
        self, *, start_time_ms: int, through_trade_id: int, limit: int = 1000,
        release_on_complete: bool = True,
    ) -> TradeHistory: ...
    def observations(
        self, source: Source, *, start_time_ms: int, end_time_ms: int, limit: int = 1000
    ) -> ObservationHistory: ...
    def resume(self, path: str) -> TradeHistory: ...

class AsyncHistory:
    def trades(
        self, *, start_time_ms: int, end_time_ms: int | None = None, limit: int = 1000
    ) -> AsyncTradeHistory: ...
    def trades_through(
        self, *, start_time_ms: int, through_trade_id: int, limit: int = 1000,
        release_on_complete: bool = True,
    ) -> AsyncTradeHistory: ...
    def observations(
        self, source: Source, *, start_time_ms: int, end_time_ms: int, limit: int = 1000
    ) -> AsyncObservationHistory: ...
    def resume(self, path: str) -> AsyncTradeHistory: ...

class Markets:
    def directory(self) -> MarketDirectory: ...
    def list(self) -> list[Market]: ...
    def subscribe(self, market: Market) -> MarketSubscription: ...
    def subscribe_current(self) -> MarketSubscription: ...

class AsyncMarkets:
    async def directory(self) -> MarketDirectory: ...
    async def list(self) -> list[Market]: ...
    def subscribe(self, market: Market) -> AsyncMarketSubscription: ...
    def subscribe_current(self) -> AsyncMarketSubscription: ...

class Bars:
    def subscribe(self, *, interval_ms: int = 1000) -> BarSubscription: ...
    def latest(self, *, interval_ms: int = 1000) -> FinalizedWindow: ...

class AsyncBars:
    def subscribe(self, *, interval_ms: int = 1000) -> AsyncBarSubscription: ...
    async def latest(self, *, interval_ms: int = 1000) -> FinalizedWindow: ...

class BarSubscription(Iterator[FinalizedWindow]):
    def __enter__(self) -> BarSubscription: ...
    def __exit__(self, *args: object) -> None: ...
    def __next__(self) -> FinalizedWindow: ...
    def close(self) -> None: ...

class AsyncBarSubscription(AsyncIterator[FinalizedWindow]):
    async def __aenter__(self) -> AsyncBarSubscription: ...
    async def __aexit__(self, *args: object) -> None: ...
    async def __anext__(self) -> FinalizedWindow: ...
    async def close(self) -> None: ...

class PublicRest:
    def btc_trade(self, source: Source = Source.BINANCE_BTCUSDT) -> OfficialBtcTrade: ...
    def book(self, market: Market, *, token_id: str) -> OfficialBook: ...

class AsyncPublicRest:
    async def btc_trade(self, source: Source = Source.BINANCE_BTCUSDT) -> OfficialBtcTrade: ...
    async def book(self, market: Market, *, token_id: str) -> OfficialBook: ...

class Client:
    prices: Prices
    history: History
    markets: Markets
    bars: Bars
    public_rest: PublicRest
    def __init__(self, endpoint: str, *, api_key: str | None = None) -> None: ...
    def __enter__(self) -> Client: ...
    def __exit__(self, *args: object) -> None: ...
    def btc_capabilities(self) -> BtcCapabilities: ...
    def btc_health(self) -> BtcHealth: ...
    def usage(self) -> Usage: ...
    def server_usage(self) -> ServerUsage: ...
    def rules(self, rules_id: str, revision: int) -> Rules: ...
    def terms(self, market: Market) -> PublicTerms: ...
    def reference(self, market: Market) -> Reference: ...
    def finality(self, market: Market) -> Finality: ...
    def evidence(self, evidence_id: str) -> Evidence: ...
    def close(self) -> None: ...

class AsyncClient:
    prices: AsyncPrices
    history: AsyncHistory
    markets: AsyncMarkets
    bars: AsyncBars
    public_rest: AsyncPublicRest
    def __init__(self, endpoint: str, *, api_key: str | None = None) -> None: ...
    async def __aenter__(self) -> AsyncClient: ...
    async def __aexit__(self, *args: object) -> None: ...
    async def btc_capabilities(self) -> BtcCapabilities: ...
    async def btc_health(self) -> BtcHealth: ...
    def usage(self) -> Usage: ...
    async def server_usage(self) -> ServerUsage: ...
    async def rules(self, rules_id: str, revision: int) -> Rules: ...
    async def terms(self, market: Market) -> PublicTerms: ...
    async def reference(self, market: Market) -> Reference: ...
    async def finality(self, market: Market) -> Finality: ...
    async def evidence(self, evidence_id: str) -> Evidence: ...
    async def close(self) -> None: ...
