[Unit]
Description=MarketCow Rust Polymarket Discovery collector (U1 isolated Paper data)
Requires=marketcow-polymarket-proxy.service
After=marketcow-polymarket-proxy.service
ConditionPathIsMountPoint=/mnt/p44pro/marketcow-shadow-v3-runtime/linux

[Service]
Type=simple
UMask=0077
ExecStart=/usr/bin/env -u ALL_PROXY -u all_proxy -u HTTPS_PROXY -u https_proxy -u HTTP_PROXY -u http_proxy HTTPS_PROXY=http://127.0.0.1:17890 HTTP_PROXY=http://127.0.0.1:17890 NO_PROXY=127.0.0.1,localhost,::1 /mnt/p44pro/marketcow-shadow-v3-runtime/linux/target/release/marketcow-discovery-collector --input-mode websocket --root /mnt/p44pro/marketcow-shadow-v3-runtime/linux/discovery-source-r1 --plan /mnt/p44pro/marketcow-shadow-v3-runtime/linux/discovery-source-r1/rust-source-plan.json --plan-sha256 655f5536841baa52a7c5680432aa621d2a14f786145a9ae0f1aae70a18f9a807 --expected-market-count 1000 --concurrency 16 --request-market-batch-size 20 --response-byte-limit 2097152 --batch-byte-limit 16777216 --persistence-queue-batches 256 --persistence-queue-bytes 67108864 --websocket-shard-tokens 50 --websocket-recovery-concurrency 16 --websocket-confirmation-seconds 0 --poll-seconds 30 --request-timeout-seconds 10
Restart=on-failure
RestartSec=2
KillSignal=SIGINT
TimeoutStopSec=40
MemoryMax=256M
NoNewPrivileges=true
StandardOutput=append:/mnt/p44pro/marketcow-shadow-v3-runtime/linux/logs/paper-discovery.log
StandardError=append:/mnt/p44pro/marketcow-shadow-v3-runtime/linux/logs/paper-discovery.log

[Install]
WantedBy=marketcow-paper-data.target
